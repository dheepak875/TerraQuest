#!/usr/bin/expect -f

set password "letsgoww"
set timeout 60

# Deploy key files and directories in a single pass to conserve PTYs
spawn scp -r terraquest_sensors.py terraquest_base.py terraquest_scout.py terraquest_scout_v2.py dashboard tools terraq@TerraQuest-2.local:~/TerraQuest/

expect {
    "Are you sure you want to continue connecting" { send "yes\r"; exp_continue }
    "password:" { send "$password\r"; exp_continue }
    eof
}

puts "\nDeployment Complete!"
