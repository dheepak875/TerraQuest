#!/usr/bin/expect -f

set password "letsgoww"
set timeout 60

# 1. Base Python Files
spawn scp terraquest_sensors.py terraquest_base.py terraquest_scout.py terraquest_scout_v2.py terraq@TerraQuest-2.local:~/TerraQuest/
expect {
    "Are you sure you want to continue connecting" { send "yes\r"; exp_continue }
    "password:" { send "$password\r"; exp_continue }
    eof
}

# 2. Dashboard App
spawn scp dashboard/app.py terraq@TerraQuest-2.local:~/TerraQuest/dashboard/
expect {
    "Are you sure you want to continue connecting" { send "yes\r"; exp_continue }
    "password:" { send "$password\r"; exp_continue }
    eof
}

# 3. HTML Templates
spawn scp dashboard/templates/index.html terraq@TerraQuest-2.local:~/TerraQuest/dashboard/templates/
expect {
    "Are you sure you want to continue connecting" { send "yes\r"; exp_continue }
    "password:" { send "$password\r"; exp_continue }
    eof
}

puts "\nDeployment Complete!"
